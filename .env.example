# Configuración de Producción
SECRET_KEY=tu-secret-key-aqui
DEBUG=False
ALLOWED_HOSTS=tu-dominio.com,www.tu-dominio.com.pythonanywhere.com

# Configuración de Correo
EMAIL_HOST=smtp.googlemail.com
EMAIL_PORT=587
EMAIL_HOST_USER=tu-correo@gmail.com
EMAIL_HOST_PASSWORD=tu-contrasena-app
EMAIL_USE_TLS=True

# Base de Datos (PythonAnywhere proporcionará estos)
DB_NAME=tu-base-de-datos
DB_USER=tu-usuario-db
DB_PASSWORD=tu-contrasena-db
DB_HOST=tu-host-db
DB_PORT=tu-puerto-db

# Redis (si usas cache)
REDIS_URL=redis://:contraseña@host:puerto/0
